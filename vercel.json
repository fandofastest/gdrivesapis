{
  "version": 2,
  "builds": [
    {
      "src": "api/[...all].js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.js", "public/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/[...all].js" },
    { "src": "/admin/?", "dest": "/admin/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/(.*)", "dest": "api/[...all].js" }
  ]
}
